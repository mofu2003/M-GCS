#!/usr/bin/env sh
set -eu

root_dir="$(git rev-parse --show-toplevel)"

if ! git diff --quiet; then
  cat >&2 <<'EOF'
[pre-commit] 存在未暂存改动。请先 stage 全部相关修改，确保门禁验证的正是即将提交的内容。
EOF
  exit 1
fi

untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  cat >&2 <<EOF
[pre-commit] 存在未跟踪文件，尚未进入本次提交：
$untracked
请先 stage、加入 .gitignore 或移出仓库。
EOF
  exit 1
fi

exec "$root_dir/tools/preflight.sh"
